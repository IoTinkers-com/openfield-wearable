{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iotinkers.com/openfield/schema/transcript.schema.json",
  "title": "Transcript",
  "description": "Transcripción de audio a texto. Registra el motor que la generó (D7).",
  "type": "object",
  "required": ["schema_version", "tenant_id", "id", "text", "engine"],
  "properties": {
    "schema_version": { "type": "string" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "media_item_id": { "type": ["string", "null"], "description": "Audio del que proviene (si se conserva)." },
    "session_id": { "type": ["string", "null"] },
    "asset_id": { "type": ["string", "null"], "description": "Activo asociado (ADR-0017)." },
    "text": { "type": "string", "minLength": 1 },
    "language": { "type": ["string", "null"], "description": "p. ej. es, en." },
    "engine": { "type": "string", "description": "Motor que generó la transcripción (p. ej. whisper-local, platform-whisper)." },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
