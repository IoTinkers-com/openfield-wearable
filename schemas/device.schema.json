{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iotinkers.com/openfield/schema/device.schema.json",
  "title": "Device",
  "description": "Dispositivo de captura y sus capacidades.",
  "type": "object",
  "required": ["schema_version", "tenant_id", "id", "device_capabilities"],
  "properties": {
    "schema_version": { "type": "string" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1, "description": "UUID del dispositivo." },
    "name": { "type": "string", "description": "Nombre legible del dispositivo." },
    "device_capabilities": {
      "type": "object",
      "description": "Capacidades del dispositivo.",
      "required": ["thermal_level", "gps", "audio"],
      "properties": {
        "model": { "type": "string" },
        "os": { "type": "string" },
        "thermal_level": { "type": ["string", "null"], "enum": ["T0", "T1", "T2", "T3", null], "description": "Nivel del contrato canónico térmico (D1)." },
        "thermal_sensor_model": { "type": ["string", "null"], "description": "p. ej. MLX90640, Lepton 3.5." },
        "thermal_resolution": {
          "type": ["object", "null"],
          "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } },
          "required": ["width", "height"]
        },
        "gps": { "type": "boolean" },
        "audio": { "type": "boolean" },
        "offline": { "type": "boolean", "description": "Soporta offline-first (siempre true en el diseño, D4)." }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
